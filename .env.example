# Copy to .env.local and fill in. Every service is optional in development:
# without Supabase the app runs in guest mode (progress on this device),
# without ElevenLabs it uses the browser's built-in speech synthesis.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used by the Stripe webhook and the TTS audio cache.
SUPABASE_SECRET_KEY=

# Stripe: Developers → API keys, and Product catalog → your Premium product's prices
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ElevenLabs: Developers → API Keys
ELEVENLABS_API_KEY=
# Pick a voice that sounds natural in Slovak from the Voice Library.
ELEVENLABS_VOICE_ID=
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v2

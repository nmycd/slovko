# Copy to .env.local and fill in. Every service is optional in development:
# without Supabase the app runs in guest mode (progress on this device),
# without ElevenLabs it uses the browser's built-in speech synthesis.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Testing only: open every lesson, ignoring lesson order and Premium.
# NEXT_PUBLIC_UNLOCK_ALL_LESSONS=true

# Supabase: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used by the Stripe webhook, the TTS audio cache and the contact form.
SUPABASE_SECRET_KEY=

# Stripe: Developers → API keys, and Product catalog → your Premium product's prices
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ElevenLabs: Developers → API Keys
ELEVENLABS_API_KEY=
# A native Slovak voice from the Voice Library (add it to "My Voices" first).
# Changing it means re-generating all course audio (npm run generate:audio).
ELEVENLABS_VOICE_ID=
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v2

# Set to false in production once course audio is pre-generated, so a cache
# miss never calls ElevenLabs (the browser's own voice is used instead).
# TTS_LIVE_GENERATION=true

# Hidden speech-to-text caps (per user per day, and all users per month).
# STT_DAILY_LIMIT=100
# STT_MONTHLY_LIMIT=20000

# Contact form (/contact). Messages are always stored in Supabase
# (contact_messages). Set both of these to also get each one by email:
# Resend → API Keys. Without a verified domain Resend sends from
# onboarding@resend.dev and only delivers to your Resend account's own address.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# After verifying a domain in Resend, e.g. Slovko <hello@yourdomain.com>
# CONTACT_FROM_EMAIL=

# Local illustration tools only (illustrations/tools), never needed on the server.
# Google AI Studio → API keys (a project with billing; image models have no free tier).
# GEMINI_API_KEY=

  "u2-l3.titleEn": {
    "en": "He, she, it: gender",
    "t": "On, ona, ono: grammatik jins"
  },
  "u2-l3.0.title": {
    "en": "People: he and she",
    "t": "Odamlar: erkak va ayol"
  },
  "u2-l3.0.body": {
    "en": [
      "Most words for people have a masculine and a feminine form. The feminine one often adds **-ka**.",
      "Slovak has no word for “a” or “the”: Lucia je študentka. = Lucia is a student."
    ],
    "t": [
      "Odamlarni bildiradigan koʻp soʻzlarning erkak va ayol shakli bor. Ayol shakli koʻpincha **-ka** qoʻshib yasaladi. Oʻzbek tilida bunday farq yoʻq: «talaba» ikkalasi uchun ham.",
      "**je** soʻzini tushirib qoldirmang: Lucia je študentka. = Lusiya talaba."
    ]
  },

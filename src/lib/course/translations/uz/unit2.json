      "Qalaysiz?"
    ]
  },
  "u2-l1.3.en": {
    "en": "Lucia is from Slovakia.",
    "t": "Lusiya Slovakiyadan."
  },
  "u2-l1.3.note": {
    "en": "**je** = is. Before s, z, š or ž, “z” becomes **zo**: zo Slovenska.",
    "t": "**je** = «-dir» (u … boʻladi). Oʻzbekchada u koʻpincha tushib qoladi, slovakchada esa kerak. s, z, š yoki ž oldidan «z» **zo** boʻladi: zo Slovenska."
  },
  "u2-l1.4.en": {
    "en": "Germany, Italy, Poland",
    "t": "Germaniya, Italiya, Polsha"
  },
  "u2-l1.4.note": {
    "en": "Many country names end in -sko or -cko. From Germany: z Nemecka.",
    "t": "Koʻp davlat nomlari -sko yoki -cko bilan tugaydi. Germaniyadan: z Nemecka."
  },

    "t": "14 qanday aytiladi?"
  },
  "u2-l6.9.en": {
    "en": "How old are you? (informal)",
    "t": "Necha yoshdasan? (sen)"
  },
  "u2-l6.9.note": {
    "en": "Literally “How many years do you have?” Polite form: Koľko **máte** rokov?",
    "t": "Soʻzma-soʻz: «Nechta yiling bor?» Hurmat shakli: Koľko **máte** rokov?"
  },
  "u2-l6.10.en": {
    "en": "I'm twenty-five.",
    "t": "Yigirma besh yoshdaman."
  },
  "u2-l6.10.note": {
    "en": "**Mám** = I have (má = he or she has). Tens and ones join into one word: dvadsať + päť = **dvadsaťpäť**.",
    "t": "**Mám** = menda bor (má = unda bor). Oʻnliklar va birliklar bitta soʻz qilib yoziladi: dvadsať + päť = **dvadsaťpäť**."
  },

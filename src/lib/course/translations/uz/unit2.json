  },
  "u2-l1.12.note": {
    "en": "Women's forms end in **-ka**: Sloven**ka**, Nem**ka** (German), Talian**ka** (Italian). Men's: Slovák, Nemec, Talian.",
    "t": "Ayollar shakli **-ka** bilan tugaydi: Sloven**ka**, Nem**ka** (nemis), Talian**ka** (italyan). Erkaklar shakli: Slovák, Nemec, Talian."
  },

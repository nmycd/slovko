  "u2-l5.titleEn": {
    "en": "Saying “not”",
    "t": "Inkor: «-ma» va «emas»"
  },
  "u2-l5.0.title": {
    "en": "Not: ne- + verb",
    "t": "Inkor: ne- + feʼl"
  },
  "u2-l5.0.body": {
    "en": [
      "To say “not”, put **ne-** in front of the verb. It is written as one word.",
      "A phrase to know by heart: **Ne**rozumiem. = I don't understand."
    ],
    "t": [
      "Inkor uchun feʼl oldiga **ne-** qoʻyiladi va qoʻshib yoziladi. Oʻzbekchada esa «-ma» feʼlning ichiga qoʻshiladi: gapiraman → gapirmayman.",
      "Yod olish kerak boʻlgan ibora: **Ne**rozumiem. = Tushunmayapman."
    ]
  },

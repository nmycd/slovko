  "u2-l6.0.en": {
    "en": "one, two, three, four, five",
    "t": "bir, ikki, uch, toʻrt, besh"
  },
  "u2-l6.0.note": {
    "en": "Zero is **nula**. “One” matches the noun's gender: jeden mobil, jedn**a** izba, jedn**o** auto.",
    "t": "Nol — **nula**. «Bir» soʻzi otning jinsiga moslashadi: jeden mobil (erkak jinsi), jedn**a** izba (ayol jinsi), jedn**o** auto (oʻrta jins)."
  },

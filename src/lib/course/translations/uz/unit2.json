  "u2-l2.1.title": {
    "en": "Ty or vy? Oni or ony?",
    "t": "Ty yoki vy? Oni yoki ony?"
  },
  "u2-l2.1.body": {
    "en": [
      "**Ty**: one friend, a child, family. **Vy**: a stranger or a teacher (polite), or any group of people.",
      "**Oni** = they, when there is at least one man in the group. **Ony** = they, for women only (or things)."
    ],
    "t": [
      "**Ty**: bitta doʻst, bola, oila aʼzosi. **Vy**: notanish odam yoki oʻqituvchi (hurmat bilan) yoki har qanday guruh. Xuddi «sen» va «siz» kabi.",
      "**Oni** = ular, agar guruhda kamida bitta erkak boʻlsa. **Ony** = ular, faqat ayollar (yoki narsalar) haqida. Oʻzbek tilida bu farq yoʻq: ikkalasi ham «ular»."
    ]
  },
  "u2-l2.1.examples": {
    "en": [
      "Mr Kováč, are you Slovak?",
      "Tomáš and Marek? They're from Slovakia.",
      "Anna and Eva? They're from Poland."
    ],
    "t": [
      "Janob Kovach, siz slovakmisiz?",
      "Tomash va Marek? Ular Slovakiyadan.",
      "Anna va Eva? Ular Polshadan."
    ]
  },
  "u2-l2.2.en": {
    "en": "I'm from Ireland.",
    "t": "Men Irlandiyadanman."
  },

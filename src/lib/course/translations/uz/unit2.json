  "u2-l1.1.en": {
    "en": "I'm from Ireland.",
    "t": "Irlandiyadanman."
  },
  "u2-l1.1.note": {
    "en": "Írsko = Ireland. After **z** (from), the -o at the end changes to **-a**: z Írsk**a**.",
    "t": "Írsko = Irlandiya. **z** = «-dan». Oʻzbekchada qoʻshimcha soʻz oxiriga qoʻshiladi, slovakchada esa **z** soʻz oldiga qoʻyiladi (bu predlog). Bunda oxirdagi -o **-a** boʻladi: z Írsk**a** = Irlandiyadan."
  },
  "u2-l1.2.question": {
    "en": "What does this mean?",
    "t": "Bu nimani anglatadi?"
  },
  "u2-l1.2.options": {
    "en": [
      "Where are you from?",
      "What's your name?",
      "How are you?"
    ],
    "t": [

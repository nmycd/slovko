  "u8-l5.8.body": {
    "en": [
      "Adjectives end in **-om** with masculine and neuter nouns, and in **-ej** with feminine ones.",
      "Môj, náš and ten work the same way: v moj**om** byte, v naš**ej** firme, v t**ej** kancelárii."
    ],
    "t": [
      "Sifatlar erkak va oʻrta jinsdagi otlar bilan **-om**, ayol jinsidagi otlar bilan **-ej** bilan tugaydi.",
      "Môj (mening), náš (bizning) va ten (bu) ham xuddi shunday oʻzgaradi: v moj**om** byte, v naš**ej** firme, v t**ej** kancelárii."
    ]
  },

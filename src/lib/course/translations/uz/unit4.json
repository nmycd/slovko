  "u4-l2.8.note": {
    "en": "Use these for directions, where to go. For where something is, you know **vľavo – vpravo**: Pošta je vľavo.",
    "t": "Bular yoʻnalish uchun: qayerga borish kerak. Narsa qayerda ekanini aytish uchun tanish **vľavo – vpravo** (chapda – oʻngda) ishlatiladi: Pošta je vľavo."
  },
  "u4-l2.9.en": {
    "en": "Go straight on, then right.",
    "t": "Toʻgʻriga yuring, keyin oʻngga."
  },
  "u4-l2.9.note": {
    "en": "**potom** = then. **Choďte** is for vy (strangers); to a friend: **Choď** rovno!",
    "t": "**potom** = keyin. **Choďte** — «siz» deb murojaat qilinadigan odamga (masalan, notanishga); doʻstingizga: **Choď** rovno!"
  },
